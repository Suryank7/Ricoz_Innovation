# Server & API Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:3000

# Database
# If left as mongodb://localhost:27017/ricoz_franchise and local Mongo is not running,
# the backend will seamlessly initialize an embedded MongoDB memory engine in development.
MONGODB_URI=mongodb://localhost:27017/ricoz_franchise

# Authentication Secrets
JWT_SECRET=franchise_super_secret_jwt_key_development_2026_x!982
JWT_EXPIRES_IN=7d

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Next.js Frontend (apps/web/.env)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
